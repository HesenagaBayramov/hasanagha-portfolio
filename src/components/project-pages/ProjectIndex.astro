---
import { campusSecure } from '../../data/projects';
import ExternalArrow from '../ui/ExternalArrow.astro';
import { projectPages } from '../../data/projectPages';
import type { Locale } from '../../data/types';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = projectPages[locale];
const detail = locale === 'az' ? '/az/projects/campussecure' : '/projects/campussecure';
---
<div class="wrap project-index-page">
  <div class="project-page-intro">
    <p class="eyebrow">{t.indexLabel}</p>
    <h1>{t.indexTitle}</h1>
    <p>{t.indexIntro}</p>
  </div>
  <article class="showcase-card">
    <figure class="showcase-art">
      <div class="showcase-image-stack">
        <img src="/projects/campussecure/login.jpg" width="1178" height="817" alt={t.loginAlt} decoding="async" />
        <figcaption class="showcase-art-caption">{t.visualCaption}</figcaption>
      </div>
    </figure>
    <div class="showcase-content">
      <p class="eyebrow">{t.featured}</p>
      <h2>{campusSecure.name}</h2>
      <p class="showcase-lead">{t.indexProjectIntro}</p>
      <p>{t.indexProjectDetail}</p>
      <div class="tags">{[...campusSecure.technologies, locale === 'az' ? 'Girişə nəzarət' : 'Access control'].map(item => <span class="tag">{item}</span>)}</div>
      <div class="showcase-actions">
        <a class="filled-button" href={detail}>{t.viewCaseStudy} <span aria-hidden="true">→</span></a>
        <a class="showcase-repo" href={campusSecure.url} target="_blank" rel="noopener noreferrer">{t.repository}<ExternalArrow /></a>
      </div>
    </div>
  </article>
  <p class="project-index-note">{t.oneProject}</p>
</div>
