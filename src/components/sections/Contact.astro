---
import type { Copy } from '../../data/types';
import ExternalArrow from '../ui/ExternalArrow.astro';
interface Props { copy: Copy; hasFormKey: boolean }
const { copy, hasFormKey } = Astro.props;
const c = copy.contact;
---
<section id="contact" class="section contact" aria-labelledby="contact-title"><div class="wrap section-inner">
  <div class="contact-heading"><p class="eyebrow"># {c.label}</p><h2 id="contact-title">{c.title}</h2><p>{c.intro}</p></div>
  <form id="contact-form" class="contact-form" novalidate>
    <div class="field-row"><label>{c.name}<input name="name" autocomplete="name" required maxlength="100" /></label><label>{c.email}<input name="email" type="email" autocomplete="email" required maxlength="254" /></label></div>
    <label>{c.message}<textarea name="message" placeholder={c.placeholder} required minlength="10" maxlength="5000" rows="6"></textarea></label>
    <input class="honeypot" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div id="form-status" class="form-status" role="status" aria-live="polite" tabindex="-1"></div>
    <button class="filled-button contact-submit" type="submit" disabled={!hasFormKey} data-send-label={c.send} data-sending-label={c.sending} data-success={c.success} data-error={`${c.errorTitle} ${c.error}`}>
      <span data-submit-label>{c.send}</span>
      <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
    </button>
    {!hasFormKey && <p class="form-unavailable">{c.unavailable}</p>}
  </form>
  <a class="contact-email" href="mailto:hsnagabayramov4@gmail.com">hsnagabayramov4@gmail.com<ExternalArrow /></a>
  <div class="social-links"><a href="https://github.com/HesenagaBayramov" target="_blank" rel="noopener noreferrer"><img class="icon-dark" src="/icons/github.svg" width="18" height="18" alt="" /><img class="icon-light" src="/icons/github-light.svg" width="18" height="18" alt="" />GitHub</a><a href="https://www.linkedin.com/in/hasanagha-bayramov-a4324134a/" target="_blank" rel="noopener noreferrer"><img class="icon-dark" src="/icons/linkedin.svg" width="18" height="18" alt="" /><img class="icon-light" src="/icons/linkedin-light.svg" width="18" height="18" alt="" />LinkedIn</a></div>
  <footer class="site-footer"><p>{c.footer}</p><div class="social-links"><a href="https://github.com/HesenagaBayramov" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><img class="icon-dark" src="/icons/github-footer.svg" width="17" height="17" alt="" /><img class="icon-light" src="/icons/github-footer-light.svg" width="17" height="17" alt="" /></a><a href="https://www.linkedin.com/in/hasanagha-bayramov-a4324134a/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><img class="icon-dark" src="/icons/linkedin-footer.svg" width="17" height="17" alt="" /><img class="icon-light" src="/icons/linkedin-footer-light.svg" width="17" height="17" alt="" /></a></div></footer>
</div></section>
<button class="back-to-top icon-button" type="button" aria-label={copy.scroll} data-back-to-top hidden><img class="icon-dark" src="/icons/up.svg" width="21" height="21" alt="" /><img class="icon-light" src="/icons/up-light.svg" width="21" height="21" alt="" /></button>
<script>
  import { submitContact } from '../../lib/web3forms';
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const topButton = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  const updateTop = () => { if (topButton) topButton.hidden = window.scrollY < 500; };
  window.addEventListener('scroll', updateTop, { passive: true }); updateTop();
  topButton?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' }));
  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = button?.querySelector<HTMLElement>('[data-submit-label]');
    const status = form.querySelector<HTMLElement>('#form-status');
    if (!button || !label || !status || button.disabled) return;
    button.disabled = true; label.textContent = button.dataset.sendingLabel ?? '';
    status.textContent = ''; status.dataset.state = '';
    const result = await submitContact(new FormData(form));
    status.textContent = result.ok ? button.dataset.success ?? '' : button.dataset.error ?? '';
    status.dataset.state = result.ok ? 'success' : 'error';
    if (result.ok) form.reset();
    button.disabled = false; label.textContent = button.dataset.sendLabel ?? '';
    status.focus();
  });
</script>
