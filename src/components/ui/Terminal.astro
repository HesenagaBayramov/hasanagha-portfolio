---
import type { Copy } from '../../data/types';
interface Props { copy: Copy }
const { terminalCopy: t } = Astro.props.copy as Copy;
---
<dialog id="terminal-dialog" class="terminal-dialog" aria-labelledby="terminal-title" data-transcript={t.transcript}>
  <audio data-keyboard-audio src="/audio/ibm-m2-typing.mp3" preload="auto" loop aria-hidden="true"></audio>
  <div class="terminal-shell">
    <div class="terminal-titlebar"><img class="icon-dark" src="/icons/window.svg" width="36" height="8" alt="" /><img class="icon-light" src="/icons/window-light.svg" width="36" height="8" alt="" /><span id="terminal-title">{t.title}</span><button type="button" class="terminal-x" data-terminal-close aria-label={t.close}>×</button></div>
    <div class="terminal-content">
      <div class="terminal-transcript"><pre id="terminal-output" aria-live="off"></pre><span class="cursor" aria-hidden="true"></span></div>
      <div class="terminal-settings"><button type="button" class="sound-toggle" data-sound-toggle data-on-label={t.soundOn} data-off-label={t.soundOff} aria-pressed="false"><img class="icon-dark" src="/icons/muted.svg" width="14" height="14" alt="" /><img class="icon-light" src="/icons/muted-light.svg" width="14" height="14" alt="" /><span class="sound-on-icon" aria-hidden="true">♪</span><span data-sound-label>{t.soundOff}</span></button><span>{t.duration}</span></div>
      <div class="terminal-actions"><button type="button" class="outline-button" data-terminal-skip>{t.skip}</button><button type="button" class="outline-button" data-terminal-replay>{t.replay}</button><button type="button" class="outline-button" data-terminal-close>{t.close} ×</button></div>
    </div>
  </div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#terminal-dialog');
  const output = document.querySelector<HTMLElement>('#terminal-output');
  const soundButton = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
  const soundLabel = document.querySelector<HTMLElement>('[data-sound-label]');
  const keyboardAudio = dialog?.querySelector<HTMLAudioElement>('[data-keyboard-audio]');
  if (keyboardAudio) { keyboardAudio.volume = 0.45; keyboardAudio.playbackRate = 2; }
  const transcript = dialog?.dataset.transcript ?? '';
  const soundOnLabel = soundButton?.dataset.onLabel ?? '';
  const soundOffLabel = soundButton?.dataset.offLabel ?? '';
  let timer: number | undefined;
  let soundOn = false;
  let typingCharacter = false;
  let playbackId = 0;
  let opener: HTMLElement | null = null;
  const syncSound = () => {
    if (!keyboardAudio) return;
    if (!soundOn) { keyboardAudio.pause(); return; }
    keyboardAudio.muted = !typingCharacter;
    if (typingCharacter && keyboardAudio.paused) void keyboardAudio.play().catch(() => { /* audio unavailable */ });
  };
  const stop = () => {
    playbackId += 1;
    if (timer !== undefined) window.clearTimeout(timer);
    timer = undefined;
    typingCharacter = false;
    keyboardAudio?.pause();
    if (keyboardAudio) { keyboardAudio.currentTime = 0; keyboardAudio.muted = true; }
  };
  const play = async () => {
    if (!output) return;
    stop();
    const currentPlayback = playbackId;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { output.textContent = transcript; return; }
    output.textContent = '';
    if (soundOn && keyboardAudio) {
      try { await keyboardAudio.play(); } catch { /* continue the visual sequence without audio */ }
      if (currentPlayback !== playbackId) return;
    }
    let position = 0;
    const nextCharacter = () => {
      if (!output || position >= transcript.length) { stop(); return; }
      const lineStart = transcript.lastIndexOf('\n', position - 1) + 1;
      const isCommand = transcript.startsWith('$ ', lineStart);
      const character = transcript[position++];
      typingCharacter = character !== '\n';
      syncSound();
      output.textContent += character;
      if (position >= transcript.length) { timer = window.setTimeout(stop, isCommand ? 90 : 30); return; }
      const delay = character === '\n'
        ? transcript[position] === '\n' ? 220 : isCommand ? 150 : 250
        : isCommand ? 90 : 30;
      timer = window.setTimeout(nextCharacter, delay);
    };
    timer = window.setTimeout(nextCharacter, 90);
  };
  document.querySelectorAll<HTMLButtonElement>('[data-terminal-open]').forEach(button => button.addEventListener('click', () => {
    if (!dialog) return;
    opener = button.closest('#mobile-nav') ? document.querySelector<HTMLElement>('[data-menu-toggle]') : button;
    document.dispatchEvent(new Event('portfolio:close-menu'));
    dialog.showModal(); void play(); dialog.querySelector<HTMLButtonElement>('[data-terminal-skip]')?.focus();
  }));
  dialog?.querySelectorAll<HTMLButtonElement>('[data-terminal-close]').forEach(button => button.addEventListener('click', () => dialog.close()));
  dialog?.querySelector<HTMLButtonElement>('[data-terminal-skip]')?.addEventListener('click', () => { stop(); if (output) output.textContent = transcript; });
  dialog?.querySelector<HTMLButtonElement>('[data-terminal-replay]')?.addEventListener('click', () => { void play(); });
  dialog?.addEventListener('close', () => { stop(); soundOn = false; if (soundButton) soundButton.setAttribute('aria-pressed', 'false'); if (soundLabel) soundLabel.textContent = soundOffLabel; opener?.focus(); });
  dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  soundButton?.addEventListener('click', () => { soundOn = !soundOn; soundButton.setAttribute('aria-pressed', String(soundOn)); if (soundLabel) soundLabel.textContent = soundOn ? soundOnLabel : soundOffLabel; if (soundOn) void play(); else syncSound(); });
</script>
