---
import '../styles/global.css';
import type { Copy, Locale } from '../data/types';
interface Props { copy: Copy; locale: Locale; pageTitle?: string; pageDescription?: string; pagePath?: string; alternatePath?: string }
const { copy, locale, pageTitle, pageDescription, pagePath, alternatePath } = Astro.props;
const title = pageTitle ? `${pageTitle} — ${copy.name}` : `${copy.name} — ${copy.role}`;
const description = pageDescription ?? copy.description;
const origin = 'https://hasanaghabayramov.vercel.app';
const pageUrl = `${origin}${pagePath ?? (locale === 'az' ? '/az' : '/')}`;
const enUrl = `${origin}${locale === 'en' ? (pagePath ?? '/') : (alternatePath ?? '/')}`;
const azUrl = `${origin}${locale === 'az' ? (pagePath ?? '/az') : (alternatePath ?? '/az')}`;
const imageUrl = `${origin}/og/portfolio-${locale}-v2.png`;
const imageAlt = locale === 'az'
  ? 'Tünd fonda bir sətirdə Həsənağa Bayramovun adı və peşə istiqaməti.'
  : 'Dark preview showing Hasanagha Bayramov on one line above his role.';
---
<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1520" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="az" href={azUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={locale === 'az' ? 'az_AZ' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'az' ? 'en_US' : 'az_AZ'} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      const navigation = performance.getEntriesByType('navigation')[0];
      if (navigation?.type === 'reload') {
        history.scrollRestoration = 'manual';
        history.replaceState(history.state, '', location.pathname + location.search);
        addEventListener('pageshow', () => scrollTo({ top: 0, left: 0, behavior: 'instant' }), { once: true });
      }
    </script>
    <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('portfolio-theme') === 'light' ? 'light' : 'dark'; } catch { /* storage unavailable */ }</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'az' ? 'Əsas məzmuna keç' : 'Skip to content'}</a>
    <slot />
  </body>
</html>
