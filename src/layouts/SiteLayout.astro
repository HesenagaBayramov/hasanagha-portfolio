---
import '../styles/global.css';
import type { Copy, Locale } from '../data/types';
interface Props { copy: Copy; locale: Locale }
const { copy, locale } = Astro.props;
const title = `${copy.name} — ${copy.role}`;
const description = copy.description;
const origin = 'https://hasanaghabayramov.vercel.app';
const pageUrl = `${origin}${locale === 'az' ? '/az' : '/'}`;
const imageUrl = `${origin}/og/portfolio-${locale}.png`;
const imageAlt = locale === 'az'
  ? 'Tünd fonda Həsənağa Bayramovun adı, peşə istiqaməti və HB. monoqramı.'
  : 'Dark preview showing Hasanagha Bayramov, his role and the HB. monogram.';
---
<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1520" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={`${origin}/`} />
    <link rel="alternate" hreflang="az" href={`${origin}/az`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={locale === 'az' ? 'az_AZ' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'az' ? 'en_US' : 'az_AZ'} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      const navigation = performance.getEntriesByType('navigation')[0];
      if (navigation?.type === 'reload') {
        history.scrollRestoration = 'manual';
        history.replaceState(history.state, '', location.pathname + location.search);
        addEventListener('pageshow', () => scrollTo({ top: 0, left: 0, behavior: 'instant' }), { once: true });
      }
    </script>
    <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('portfolio-theme') === 'light' ? 'light' : 'dark'; } catch { /* storage unavailable */ }</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'az' ? 'Əsas məzmuna keç' : 'Skip to content'}</a>
    <slot />
  </body>
</html>
